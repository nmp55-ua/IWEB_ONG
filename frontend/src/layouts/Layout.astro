---
// Layout común de todas las páginas: cabecera, menú según rol y pie.
import Menu from '../components/comunes/Menu.jsx';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · ONG</title>
  </head>
  <body class="min-h-screen flex flex-col bg-marca-50 text-gray-900 font-sans">
    <header class="bg-marca-700 text-white">
      <div class="max-w-5xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <a href="/" class="text-lg font-semibold">ONG · Donaciones y Voluntariado</a>
        <Menu client:load />
      </div>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 py-8">
      <h1 class="text-2xl font-bold text-marca-700 mb-6">{titulo}</h1>
      <slot />
    </main>

    <footer class="border-t border-marca-100 bg-white">
      <div class="max-w-5xl mx-auto px-4 py-4 text-sm text-gray-600">
        Gracias por colaborar con tu dinero y con tu tiempo.
      </div>
    </footer>
  </body>
</html>
