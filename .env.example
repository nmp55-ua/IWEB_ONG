# Copia este fichero a .env y rellena los valores. .env nunca se sube al repositorio.

# Base de datos (la de docker-compose.yml)
DATABASE_URL=postgres://ong:ong_dev@localhost:5432/ong

# Sesiones: pon una cadena larga y aleatoria
SESSION_SECRET=

# Contraseña común de los usuarios de prueba que crea «npm run semillas»
CONTRASENA_SEMILLAS=

PORT=3000
FRONTEND_URL=http://localhost:4321

# Datos de la ONG (encabezado de certificados e informes)
ONG_NOMBRE=ONG Manos Unidas por el Agua
ONG_CIF=G00000000
ONG_DIRECCION=Calle Ejemplo 1, 03690 San Vicente del Raspeig (Alicante)

# Correo (Mailpit en desarrollo)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ONG <no-responder@ong.test>

# Stripe en MODO DE PRUEBAS: solo claves sk_test_... y el secreto que da «stripe listen»
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Solo para pruebas: fija «ahora» (ISO 8601), por ejemplo 2026-01-01T00:10:00+01:00
AHORA_SIMULADO=
